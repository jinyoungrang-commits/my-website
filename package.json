{
  "name": "dagachi-campus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "build:site": "vite build --mode static",
    "preview:site": "vite preview --mode static --host 127.0.0.1",
    "preview:pages": "vite preview --mode pages --host 127.0.0.1",
    "publish:pages": "npm run build:pages && node scripts/publish-pages.mjs",
    "test:pages": "playwright test --config playwright.pages.config.js",
    "start": "node server/index.mjs",
    "test": "playwright test",
    "test:api": "node --test tests/api.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "^5.3.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
